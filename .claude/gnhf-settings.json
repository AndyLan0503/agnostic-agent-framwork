{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git remote*)",
      "Bash(gh *)",
      "Bash(gcloud *)",
      "Bash(aws *)",
      "Bash(az *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform plan*)",
      "Bash(terraform init*)",
      "Bash(terraform import*)",
      "Bash(terraform state*)",
      "Bash(terraform refresh*)",
      "Bash(terraform workspace*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(docker push*)",
      "Bash(npm publish*)",
      "Bash(docker run*)",
      "Bash(docker exec*)",
      "Bash(docker create*)",
      "Bash(podman run*)",
      "Bash(podman exec*)",
      "Bash(podman create*)",
      "Bash(timeout *)",
      "Bash(flock *)",
      "Bash(su *)",
      "Bash(busybox *)",
      "Bash(uv *)",
      "Bash(poetry *)",
      "Bash(pipenv *)",
      "Bash(conda *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*serviceaccount*.json)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/framework/scripts/gnhf_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
